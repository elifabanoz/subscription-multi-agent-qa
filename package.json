{
  "name": "subscription-multi-agent-qa",
  "version": "0.5.3",
  "description": "Source-focused multi-agent QA runner powered by local Codex and Claude subscription sessions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elifabanoz/subscription-multi-agent-qa.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run plan",
    "setup:wsl": "bash scripts/bootstrap-wsl.sh",
    "setup:browser": "playwright install chromium",
    "plan": "node src/cli.mjs plan",
    "doctor": "node src/cli.mjs doctor",
    "live:doctor": "node src/cli.mjs live-doctor",
    "demo": "node src/demo.mjs",
    "capture:demo": "node scripts/capture-demo.mjs",
    "smoke:android": "node test/fixtures/android-smoke.mjs",
    "smoke:dashboard": "node test/fixtures/dashboard-smoke.mjs",
    "audit": "node src/cli.mjs audit",
    "team": "node src/cli.mjs team"
  },
  "dependencies": {
    "playwright": "1.65.1"
  }
}
